# Copie para .env e preencha. NUNCA coloque valores reais neste arquivo de exemplo.

AMBIENTE=local
# 32+ caracteres aleatórios em produção (a API se recusa a subir sem isso).
JWT_SEGREDO=
URL_PUBLICA_API=http://localhost:8000
URL_PUBLICA_APP=http://localhost:8080
CORS_ORIGENS=http://localhost:8080

# Banco e fila (o docker-compose já define estes para os contêineres)
DATABASE_URL=postgresql+psycopg://entrelinhas:entrelinhas@localhost:5432/entrelinhas
REDIS_URL=redis://localhost:6379/0
TAREFAS_MODO=thread

# Classificador (seção 4.7): anthropic | openai | google | nenhum
PROVEDOR_LLM=nenhum
# Vazio usa o padrão do provedor (Anthropic: claude-opus-5-5). OpenAI e Google exigem valor.
MODELO_LLM=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_FALLBACKS=true

# Fontes públicas (vazio = sem rede)
FONTES_METADADOS=google_books,open_library
GOOGLE_BOOKS_API_KEY=
FONTES_RESENHAS=wikipedia_pt

# Reconhecimento
MOTOR_OCR=tesseract
GOOGLE_VISION_API_KEY=
# histograma (padrão, sem rede neural) | dinov2 (requer pip install -e "backend[ml]")
MODELO_CAPA=histograma
MODELO_CAPA_NOME=facebook/dinov2-small
MODELO_CAPA_PESOS_LOCAIS=

# Pagamentos: falso (local, ativa na hora) | stripe
PROVEDOR_PAGAMENTO=falso
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECO_FAMILIA=
STRIPE_PRECO_ESCOLA=
APPLE_BUNDLE_ID=
# "<issuer_id>|<key_id>|<chave privada PEM>"
APPLE_SHARED_SECRET=
GOOGLE_PLAY_PACOTE=
GOOGLE_PLAY_CONTA_SERVICO_JSON=

# Login social (IDs de cliente separados por vírgula)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# E-mail: console (registra no log) | smtp
PROVEDOR_EMAIL=console
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=nao-responda@entrelinhas.app

# Armazenamento de amostras consentidas: local | s3
ARMAZENAMENTO=local
PASTA_ARQUIVOS=dados_locais/arquivos
